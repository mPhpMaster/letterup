# --- Discord (Developer Portal -> your app -> OAuth2) ---
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon key or the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key or the newer "secret" key (sb_secret_...) — server only, never expose
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Long random string used to sign player session tokens: `openssl rand -base64 32`
SESSION_SECRET=
# Lets you play in a normal browser tab without Discord (?room=abc). Keep false in production.
ALLOW_GUEST_MODE=true
# Discord user ids (comma separated) allowed to read suggestions/reports and ban players.
ADMIN_USER_IDS=
# Random string used by the daily cleanup cron; Vercel sets this for you when you add it.
CRON_SECRET=
